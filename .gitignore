# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Coverage / type
.coverage
htmlcov/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Versioned packaging outputs (old runtime data must be preserved)
