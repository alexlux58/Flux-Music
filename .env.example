# Music Library — example environment overrides
# Copy to .env and adjust. Never commit real secrets.

# MUSIC_LIBRARY_ROOT=./music
# MUSIC_LIBRARY_TEMP=./.tmp
# MUSIC_LIBRARY_DB=./data/music_library.db
# MUSIC_LIBRARY_LOG_LEVEL=INFO
# MUSIC_LIBRARY_WEB_HOST=127.0.0.1
# MUSIC_LIBRARY_WEB_PORT=8787
# Bind to LAN only behind WireGuard/VPN if exposing to other devices:
# MUSIC_LIBRARY_WEB_HOST=0.0.0.0
